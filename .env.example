# ── Local development ────────────────────────────────────────────────
# The site is a fully STATIC export now, so no runtime database is required to
# build or preview it. DATABASE_URL is only needed if you run the legacy
# sandbox-only API routes (they have been removed).
# DATABASE_URL="file:./dev.db"

# ── Production: Cloudflare Pages environment variables ───────────────
# Where the speaking-invitation form POSTs. Point this at the deployed
# `eryeza-speaking` Worker. If it is left unset the form falls back to
# /api/speaking, which no longer exists in the static export, so SET THIS.
NEXT_PUBLIC_SPEAKING_ENDPOINT="https://eryeza-speaking.<your-subdomain>.workers.dev"

# Optional: Resend key for the Worker's fallback email path. Normally the Worker
# uses Cloudflare's native Email Service binding instead, so this is optional.
# RESEND_API_KEY="re_..."

# --- Giving -----------------------------------------------------------------
# Destination for the Giving button. Public URL only: the hosted Flutterwave
# donation page is the system of record. NO secret keys, ever.
# Leave unset to use the default. To switch the button OFF use a sentinel value:
#   NEXT_PUBLIC_GIVING_URL=off
# An EMPTY value does NOT disable it: Next treats empty as unset, so it would
# fall back to the default. With a sentinel the UI renders a disabled control
# with a plain note instead of a link.
NEXT_PUBLIC_GIVING_URL=https://flutterwave.com/donate/h2tj4bfhltce

# --- Click logging ----------------------------------------------------------
# Where Giving clicks are recorded (our own Worker). Leave unset and tracking is
# skipped silently; the Giving link itself still works.
NEXT_PUBLIC_EVENTS_ENDPOINT=https://eryeza-speaking.preryezakalalu.workers.dev/events
