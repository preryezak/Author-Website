# Cloudflare Workers Static Assets / Pages headers for eryezakalalu.com
#
# NOTE: Cloudflare joins duplicate header names with a comma, so Cache-Control is
# set ONLY in the path-specific rules below and never in `/*`.
#
# CSP allows exactly the third-party origins the site actually uses:
#  - Beehiiv (attribution.js + the embedded subscribe iframe)
#  - iHeart (the Devotion In Season podcast iframe player)
# Google Fonts is deliberately absent: next/font/google downloads and self-hosts
# the woff2 files at build time, so no request ever goes to fonts.googleapis.com
# or fonts.gstatic.com (verified: 0 references in the built HTML).
# Commerce links (Payhip, Selar, Audible, Spotify, Apple, Amazon, Castbox) open
# Our own Cloudflare Worker (speaking invitations + the Giving click record) is
# listed in connect-src: without it the browser blocks both the speaking form's
# POST and the Giving click beacon.
# in new tabs via <a target="_blank" rel="noopener noreferrer"> - top-level
# navigations, not resource loads, so CSP does not need to list them.

# Phase 0 (1 Oct 2026):
#  - frame-src += youtube-nocookie.com: the /podcast/ latest-episode player,
#    loaded only when pressed (poster from i.ytimg.com is covered by img-src https:).
#  - media-src += anchor.fm and *.cloudfront.net: RSS audio enclosures are
#    anchor.fm URLs that 302 to CloudFront, so the in-page episode players were
#    being blocked. The /study/ form posts same-origin (/api/study Worker route).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://subscribe-forms.beehiiv.com https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; frame-src 'self' https://challenges.cloudflare.com https://subscribe-forms.beehiiv.com https://www.iheart.com https://www.youtube-nocookie.com; connect-src 'self' https://cloudflareinsights.com https://challenges.cloudflare.com https://eryeza-speaking.preryezakalalu.workers.dev https://app.kit.com; media-src 'self' https://*.iheart.com https://anchor.fm https://*.cloudfront.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=(), payment=(), usb=(), serial=(), midi=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  X-DNS-Prefetch-Control: off
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1

# Fingerprinted build assets (hash in the filename) never change - cache hard.
/_next/static/*
  Cache-Control: public, max-age=31556952, immutable

# Unhashed static media: cache for 30 days, allow stale-while-revalidate.
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/brand/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/logo.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# Brand film: unhashed, so cache for 30 days; the browser still revalidates cheaply.
/video/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/audio/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# Crawler/discovery files can change at any time.
/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

# Study Library and guide PDFs: unlisted (reached from the Kit confirmation
# email). Replace the site-wide index header rather than joining it.
/resources/library/*
  ! X-Robots-Tag
  X-Robots-Tag: noindex, nofollow

/resources/guides/*
  ! X-Robots-Tag
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=3600
